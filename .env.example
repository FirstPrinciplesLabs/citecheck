# LLM provider keys
# Required at runtime depending on which provider you select via
# --llm_provider {openai,anthropic,google}.

OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key

# Optional: alternate name for the OpenAI key. When OPENAI_API_KEY is
# unset and CSG_OPENAI_API_KEY is set, the package aliases the latter
# to the former at import time.
CSG_OPENAI_API_KEY=

# Optional: Semantic Scholar API key (raises rate limit; the cascade
# works without it but may be throttled under heavy use).
S2_API_KEY=

# Optional: OpenAlex contact email (recommended by their TOS for
# polite-pool access).
OPENALEX_MAILTO=
